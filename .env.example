# Copy to root .env with npm run setup. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR_NEON_HOST/DATABASE?sslmode=require
APP_ORIGIN=http://localhost:5173
PORT=4000
NODE_ENV=development
# Opt-in synthetic fixtures only; disabled in production.
SEED_DEMO=false
DEMO_PASSWORD=
# Optional fresh-bank bootstrap settings. Remove password after creation.
BANK_CODE=
BANK_NAME=
BANK_ADMIN_NAME=
BANK_ADMIN_EMAIL=
BANK_ADMIN_PASSWORD=
